{
    "name": "personal-finances",
    "version": "1.0.0",
    "description": "Personal Finances Web App",
    "main": "src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:generate": "drizzle-kit generate:sqlite",
        "db:migrate": "tsx src/db/commands/migrate.ts",
        "db:seed": "npm run db:migrate && tsx src/db/commands/seed.ts",
        "db:reset": "npm run db:migrate && tsx src/db/commands/reset.ts",
        "api:dev": "tsx watch src/api/index.ts",
        "test": "vitest run"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@hono/node-server": "^1.19.7",
        "@hono/zod-validator": "^0.7.6",
        "better-sqlite3": "^12.5.0",
        "commander": "^14.0.2",
        "csv-parse": "^5.5.0",
        "drizzle-orm": "^0.30.0",
        "hono": "^4.11.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^20.0.0",
        "drizzle-kit": "^0.20.0",
        "tsx": "^4.22.4",
        "typescript": "^5.0.0",
        "vitest": "^4.0.16"
    }
}
